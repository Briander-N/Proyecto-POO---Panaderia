<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.panaderia_el_panshito.controller.UsuarioController">
    <stylesheets>
        <URL value="@../styles.css" />
    </stylesheets>

    <top>
        <HBox spacing="15" styleClass="top-bar">
            <Label styleClass="top-bar-title" text="Gestión de Usuarios" />
            <Button onAction="#volverDashboard" styleClass="btn-back" text="Volver al Dashboard" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15" styleClass="user-panel">

            <HBox spacing="10">
                <TextField fx:id="txtNombre" promptText="Nombre completo" styleClass="input-field" />
                <TextField fx:id="txtCorreo" promptText="Correo" styleClass="input-field" />
                <PasswordField fx:id="txtPassword" promptText="Contraseña" styleClass="input-field" />
                <ComboBox fx:id="comboRol" promptText="Rol" />
            </HBox>

            <HBox spacing="10">
                <Button onAction="#guardar" styleClass="btn-success" text="Crear Usuario" />
                <Button onAction="#limpiar" styleClass="btn-success" text="Limpiar" />
            </HBox>

            <TableView fx:id="tablaUsuarios" prefHeight="350">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="180" text="Nombre" />
                    <TableColumn fx:id="colCorreo" prefWidth="200" text="Correo" />
                    <TableColumn fx:id="colRol" prefWidth="100" text="Rol" />
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>
