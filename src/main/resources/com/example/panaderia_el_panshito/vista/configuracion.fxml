<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.panaderia_el_panshito.controller.ConfiguracionController">

    <top>
        <HBox spacing="15" style="-fx-padding: 10;">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Configuración del Sistema" />
            <Button onAction="#volverDashboard" text="Volver al Dashboard" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            <Label text="Nombre de la empresa" />
            <TextField fx:id="txtNombreEmpresa" />

            <Label text="Dirección" />
            <TextField fx:id="txtDireccion" />

            <Button onAction="#guardar" text="Guardar Configuración" />
        </VBox>
    </center>

</BorderPane>
