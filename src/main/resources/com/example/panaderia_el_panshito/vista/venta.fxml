<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.panaderia_el_panshito.controller.VentaController">

    <top>
        <HBox spacing="15" style="-fx-padding: 10;">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Registrar Venta" />
            <Button onAction="#volverDashboard" text="Volver al Dashboard" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding: 15;">

            <Label text="Selecciona un producto de la tabla y registra la venta:" />

            <TableView fx:id="tablaProductos" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="220" text="Nombre" />
                    <TableColumn fx:id="colPrecio" prefWidth="120" text="Precio" />
                    <TableColumn fx:id="colStock" prefWidth="120" text="Stock" />
                </columns>
            </TableView>

            <Label fx:id="lblProductoSeleccionado" text="Ningún producto seleccionado" />

            <HBox spacing="10">
                <TextField fx:id="txtCantidad" promptText="Cantidad a vender" />
                <Button onAction="#registrarVenta" text="Registrar Venta" />
                <Button onAction="#limpiar" text="Limpiar" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
