<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #BAB1B1;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.panaderia_el_panshito.controller.VentaController">

    <top>
        <HBox spacing="15" style="-fx-padding: 12; -fx-background-color: #2c3e50;">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: &quot;Cooper Black&quot;;" text="Registrar Venta" />
            <Button onAction="#volverDashboard" style="-fx-background-color: #00A3F5; -fx-background-radius: 6; -fx-cursor: hand;" text="Volver al Dashboard" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 2);">

            <Label text="Selecciona un producto de la tabla y registra la venta:" />

            <TableView fx:id="tablaProductos" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="220" text="Nombre" />
                    <TableColumn fx:id="colPrecio" prefWidth="120" text="Precio" />
                    <TableColumn fx:id="colStock" prefWidth="120" text="Stock" />
                </columns>
            </TableView>

            <Label fx:id="lblProductoSeleccionado" text="Ningún producto seleccionado" />

            <HBox spacing="10">
                <TextField fx:id="txtCantidad" promptText="Cantidad a vender" style="-fx-padding: 6;" />
                <Button onAction="#registrarVenta" style="-fx-font-weight: bold; -fx-background-color: #6B8E23; -fx-text-fill: white; -fx-cursor: hand;" text="Registrar Venta" />
                <Button onAction="#limpiar" style="-fx-font-weight: bold; -fx-background-color: #6B8E23; -fx-text-fill: white; -fx-cursor: hand;" text="Limpiar" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
