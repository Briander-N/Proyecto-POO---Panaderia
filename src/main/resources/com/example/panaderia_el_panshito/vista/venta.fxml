<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.panaderia_el_panshito.controller.VentaController">
    <stylesheets>
        <URL value="@../styles.css" />
    </stylesheets>

    <top>
        <HBox spacing="15" styleClass="top-bar">
            <Label styleClass="top-bar-title" text="Registrar Venta" />
            <Button onAction="#volverDashboard" styleClass="btn-back" text="Volver al Dashboard" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15" styleClass="venta-panel">

            <Label text="Selecciona un producto de la tabla y registra la venta:" />

            <TableView fx:id="tablaProductos" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="220" text="Nombre" />
                    <TableColumn fx:id="colPrecio" prefWidth="120" text="Precio" />
                    <TableColumn fx:id="colStock" prefWidth="120" text="Stock" />
                </columns>
            </TableView>

            <Label fx:id="lblProductoSeleccionado" text="Ningún producto seleccionado" />

            <HBox spacing="10">
                <TextField fx:id="txtCantidad" promptText="Cantidad a vender" styleClass="qty-field" />
                <Button onAction="#registrarVenta" styleClass="btn-success" text="Registrar Venta" />
                <Button onAction="#limpiar" styleClass="btn-success" text="Limpiar" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
